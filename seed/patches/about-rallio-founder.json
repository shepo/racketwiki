      {
       "_key": "s0",
       "_type": "span",
       "marks": [],
       "text": "We cover the well-known sports and the obscure ones in the same structure, so you can compare a padel court with a squash court, or a badminton racket with a table tennis bat, on one page."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b1",
     "_type": "block",
     "children": [
      {
       "_key": "s1",
       "_type": "span",
       "marks": [],
       "text": "How we work"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "b2",
     "_type": "block",
     "children": [
      {
       "_key": "s2",
       "_type": "span",
       "marks": [],
       "text": "Every fact that could be wrong carries a source, the tier of that source and the date we last checked it. Where we do not know something yet, the page says so instead of guessing."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b3",
     "_type": "block",
     "children": [
      {
       "_key": "s3",
       "_type": "span",
       "marks": [],
       "text": "Our summaries are written by our editors from the primary sources, which we link to. We do not copy text from other websites."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b4",
     "_type": "block",
     "children": [
      {
       "_key": "s4",
       "_type": "span",
       "marks": [],
