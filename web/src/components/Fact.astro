---
/**
 * Renders a sourcedFact. Unverified or unsourced facts are never shown as fact:
 * they render a "Being verified" placeholder instead. Sources are listed once, at the
 * foot of the page (SourceList), not beside each fact.
 */
import type {Fact} from '../lib/content'
import {factText, isShown} from '../lib/facts'
type Props = {fact?: Fact | null; placeholder?: string}
const {fact, placeholder = 'Being verified'} = Astro.props as Props
const text = factText(fact)
---
{isShown(fact) && text ? (
  <span class="fact">{text}</span>
) : (
  <span class="pending" title="We have not verified this yet">{placeholder}</span>
)}
