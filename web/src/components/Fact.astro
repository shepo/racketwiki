---
/**
 * Renders a sourcedFact. Unverified or unsourced facts are never shown as fact:
 * they render a "Being verified" placeholder instead.
 */
import type {Fact} from '../lib/content'
import {getStore} from '../lib/content'
import {factText, factSource, isShown} from '../lib/facts'
type Props = {fact?: Fact | null; showSource?: boolean; placeholder?: string}
const {fact, showSource = false, placeholder = 'Being verified'} = Astro.props as Props
const store = await getStore()
const text = factText(fact)
const src = factSource(store, fact)
---
{isShown(fact) && text ? (
  <span class="fact">{text}{showSource && src && <span class="src"> <a class="hl" href={`/sources/#${src.slug?.current}`}>{src.name}</a>{fact!.citation ? `, ${fact!.citation}` : ''} <span class="tier"><b>Tier {fact!.tier}</b></span></span>}</span>
) : (
  <span class="pending" title="We have not verified this yet">{placeholder}</span>
)}
<style>
  .src { font-size: var(--fs-xs); color: var(--muted); }
</style>
