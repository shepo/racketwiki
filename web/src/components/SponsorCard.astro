---
import type {Doc} from '../lib/content'
const {placement, pagePath} = Astro.props as {placement?: Doc; pagePath: string}
const c = placement?.creative ?? {}
const rallio = c.theme === 'rallio'
---
{placement && (
  <section aria-label="Sponsored" class:list={['sc', {rallio}]}>
    <span class="lbl">Sponsored by</span>
    <strong class="who">{placement.sponsor}</strong>
    {c.headline && <p class="head">{c.headline}</p>}
    {c.body && <p class="body">{c.body}</p>}
    {c.ctaUrl && <a class="cta" href={c.ctaUrl} rel="sponsored noopener">{c.ctaLabel ?? `Learn about ${placement.sponsor}`}</a>}
    <a class="hl own" href={`/sponsor/?page=${encodeURIComponent(pagePath)}`}>Sponsor this page</a>
  </section>
)}
<style>
  .sc { padding: 18px; border-radius: 10px; display: flex; flex-direction: column; gap: 10px; background: var(--panel); border: 1px solid var(--rule); }
  .sc.rallio { background: #fafaf7; border-color: #ddddce; color: #2b2b24; }
  .lbl { font-size: var(--fs-xs); font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: #64645a; }
  .who { font-family: var(--font-rallio); font-weight: 600; font-size: var(--fs-lg); line-height: 1; color: #37372e; }
  .head { margin: 0; font-family: var(--font-rallio); font-weight: 400; font-size: var(--fs-md); line-height: 1.25; }
  .body { margin: 0; font-size: var(--fs-sm); }
  .cta { align-self: flex-start; padding: 9px 14px; background: #37372e; color: #fafaf7; border-radius: 8px; font-weight: 400; font-size: var(--fs-sm); }
  .own { font-size: var(--fs-xs); font-weight: 600; color: #64645a; }
</style>
