---
/** Influence rating, 1–5, drawn as rackets. Filled = counts, outline = remaining. */
const {value, size = 16, label = true} = Astro.props as {value?: number; size?: number; label?: boolean}
const n = Math.max(0, Math.min(5, Math.round(value ?? 0)))
---
{n > 0 && (
  <span class="rk" role="img" aria-label={`Influence ${n} out of 5`} title={`Influence rating: ${n} out of 5`}>
    {[1, 2, 3, 4, 5].map((i) => (
      <svg width={Math.round(size * 0.6)} height={size} viewBox="0 0 12 20" aria-hidden="true" class:list={[i <= n ? 'on' : 'off']}>
        <ellipse class="head" cx="6" cy="6.2" rx="4.6" ry="5.4" />
        <path class="str" d="M3.6 3.6v5.2M6 1.6v9.2M8.4 3.6v5.2M1.9 4.8h8.2M1.4 7.4h9.2M2.4 9.8h7.2" />
        <path class="throat" d="M4.2 11.2 6 13.2 7.8 11.2" />
        <rect class="grip" x="5" y="13" width="2" height="6.4" rx="1" />
      </svg>
    ))}
    {label && <span class="sr-only">Influence {n} out of 5</span>}
  </span>
)}
<style>
  .rk { display: inline-flex; gap: 2px; vertical-align: middle; }
  .rk { gap: 3px; }
  .head { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .str { stroke: currentColor; stroke-width: 0.5; opacity: 0.6; fill: none; }
  .throat { fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round; }
  .grip { fill: currentColor; }
  svg.on { color: var(--sec-sports); }
  svg.off { color: var(--rule); }
  svg.off .str { opacity: 0; }
</style>
