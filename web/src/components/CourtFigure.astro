---
import type {Doc} from '../lib/content'
import {getStore} from '../lib/content'
import {courtGeometry, courtSvg} from '../lib/court'
import {factSource} from '../lib/facts'
const {court, compact = false} = Astro.props as {court?: Doc; compact?: boolean}
const store = await getStore()
const g = courtGeometry(court)
const src = factSource(store, court?.length)
---
{g ? (
  <figure>
    <Fragment set:html={courtSvg(g, court!.name ?? 'Court', {width: compact ? 560 : 700})} />
    <figcaption>{court!.name}, drawn to scale.{src && <> Source: <a class="hl" href={`/sources/#${src.slug?.current}`}>{src.name}</a>{court!.length.citation ? `, ${court!.length.citation}` : ''}.</>}</figcaption>
  </figure>
) : court?.standard === false ? (
  <p class="note">{court.nonStandardNote ?? 'This court is not standard: every venue differs.'}</p>
) : (
  <p class="note">The court diagram appears once its dimensions are verified against the rulebook.</p>
)}
