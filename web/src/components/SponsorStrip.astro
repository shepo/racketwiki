---
import type {Doc} from '../lib/content'
const {placement} = Astro.props as {placement?: Doc}
const c = placement?.creative ?? {}
---
{placement && (
  <div class="strip" aria-label="Sponsor">
    <div class="wrap strip-in">
      <span class="lbl">Sponsored by</span>
      <strong class="who">{placement.sponsor}</strong>
      {c.body && <span>{c.body}</span>}
      {c.ctaUrl && <a href={c.ctaUrl} rel="sponsored noopener" class="hl cta">{c.ctaLabel ?? 'Learn more'}</a>}
    </div>
  </div>
)}
<style>
  .strip { background: #fafaf7; border-bottom: 1px solid #ddddce; color: #64645a; }
  .strip-in { padding-top: 8px; padding-bottom: 8px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 12px; font-size: 12px; }
  .lbl { letter-spacing: 0.08em; text-transform: uppercase; font-weight: 500; }
  .who { font-family: var(--font-rallio); font-weight: 700; font-size: 14px; color: #37372e; }
  .cta { font-weight: 600; color: #2b2b24; }
</style>
