---
/** Cookie banner plus consent-gated PostHog. Nothing is loaded or stored until a reader accepts. */
import {SITE} from '../site.config'
---
{SITE.posthogKey && (
  <div id="cc" class="cc" role="dialog" aria-label="Cookies" aria-live="polite" data-key={SITE.posthogKey} data-host={SITE.posthogHost} hidden data-pagefind-ignore>
    <div class="cc-in">
      <p><strong>Can we count your visit?</strong> We'd like to use analytics cookies to see which pages people read and how they move around the site, so we can improve it and show sponsors how many people we reach. We never sell your data. <a href="/cookies/">How we use cookies</a></p>
      <div class="cc-btns">
        <button type="button" data-consent="denied">Reject</button>
        <button type="button" data-consent="granted">Accept</button>
      </div>
    </div>
  </div>
)}
<script>
  import {initConsent} from '../scripts/analytics'
  initConsent()
</script>
<style>
  .cc { position: fixed; inset: auto 0 0 0; z-index: 50; padding: 0 16px 16px; pointer-events: none; }
  .cc-in { pointer-events: auto; max-width: 760px; margin: 0 auto; padding: 16px 18px; background: var(--bg); color: var(--ink); border: 1.5px solid var(--ink); box-shadow: 0 6px 24px rgb(0 0 0 / 0.18); display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .cc p { margin: 0; flex: 1 1 380px; font-size: var(--fs-sm); }
  .cc a { text-decoration: underline; }
  .cc-btns { display: flex; gap: 10px; }
  .cc button { font: inherit; font-size: var(--fs-sm); font-weight: 600; padding: 9px 18px; border: 1.5px solid var(--ink); background: var(--bg); color: var(--ink); cursor: pointer; min-width: 96px; }
  .cc button:hover { background: var(--ink); color: var(--bg); }
</style>
