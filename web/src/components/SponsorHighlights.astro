---
/** Sponsor page rail: why sponsor RacketWiki. Audience figures appear once there is enough traffic to report. */
import {getAudience, MIN_VISITORS} from '../lib/audience'
import {getStore, nameOf} from '../lib/content'
const store = await getStore()
const audience = await getAudience()
const show = audience && audience.visitors >= MIN_VISITORS ? audience : null
const n = (v: number) => v.toLocaleString('en-GB')
const sportName = (slug: string) => nameOf(store.ofType('sport').find((s) => s.slug?.current === slug)) || slug
const content = [
  {v: store.ofType('sport').length, l: 'racket sports covered'},
  {v: store.ofType('governingBody').length, l: 'governing bodies and associations'},
  {v: store.ofType('player').length, l: 'player profiles'},
  {v: store.ofType('source').length, l: 'cited sources'},
]
const date = (iso: string) => new Date(iso).toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'})
---
<section class="hi" aria-labelledby="hi-h">
  <h2 id="hi-h" class="kicker">Why sponsor RacketWiki</h2>
  {show && (
    <>
      <p class="sub">Last {show.days} days</p>
      <dl class="stats">
        <div><dt>Readers</dt><dd>{n(show.visitors)}</dd></div>
        <div><dt>Pages read</dt><dd>{n(show.pageviews)}</dd></div>
        <div><dt>Pages per visit</dt><dd>{show.sessions ? (show.pageviews / show.sessions).toFixed(1) : '–'}</dd></div>
        {show.searches > 0 && <div><dt>Searches</dt><dd>{n(show.searches)}</dd></div>}
      </dl>
      {show.topSports.length > 0 && (
        <>
          <h3>Most-read sports</h3>
          <ol class="top">{show.topSports.map((s) => <li><a href={`/sports/${s.slug}/`}>{sportName(s.slug)}</a></li>)}</ol>
        </>
      )}
      {show.topPages.length > 0 && (
        <>
          <h3>Most-read pages</h3>
          <ol class="top">{show.topPages.map((p) => <li><a href={p.path}>{p.title || p.path}</a></li>)}</ol>
        </>
      )}
      <p class="note">Counted from readers who accept analytics cookies, so the real audience is larger. Updated {date(show.measuredOn)}.</p>
    </>
  )}
  <h3>What readers find here</h3>
  <dl class="stats">
    {content.map((c) => <div><dt>{c.l}</dt><dd>{n(c.v)}</dd></div>)}
  </dl>
  <ul class="why">
    <li>Readers are players, coaches and club organisers, reading about the sport they play.</li>
    <li>Sponsor a single page, one sport, or a whole section such as Courts or Equipment.</li>
  </ul>
</section>
<style>
  .hi { padding: 18px; border: 1.5px solid var(--sec-sources); display: flex; flex-direction: column; gap: 10px; }
  .hi .kicker { margin: 0; color: var(--sec-sources); }
  .sub { margin: -4px 0 0; font-size: var(--fs-xs); color: var(--muted); }
  h3 { margin: 8px 0 0; font-size: var(--fs-sm); font-weight: 600; }
  .stats { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { font-size: var(--fs-xs); color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--font-head); font-weight: 700; font-size: var(--fs-xl); line-height: 1.1; }
  .top { margin: 0; padding-left: 20px; font-size: var(--fs-sm); }
  .top a:hover { text-decoration: underline; }
  .note { margin: 0; font-size: var(--fs-xs); color: var(--muted); }
  .why { margin: 4px 0 0; padding-left: 18px; font-size: var(--fs-sm); color: var(--ink-2); }
</style>
