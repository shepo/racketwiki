---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SponsorStrip from '../components/SponsorStrip.astro'
import JsonLd from '../components/JsonLd.astro'
import {getStore} from '../lib/content'
import {pickPlacement} from '../lib/sponsors'
import {siteJsonLd, breadcrumbJsonLd, abs, type Crumb} from '../lib/seo'
import {SECTIONS, type SectionKey} from '../lib/sections'

type Props = {
  title: string
  description: string
  section?: SectionKey
  /** Section shown in the main nav as current. */
  navActive?: string
  crumbs?: Crumb[]
  jsonLd?: unknown[]
  sportId?: string
  canonical?: string
  noindex?: boolean
  headerSearch?: boolean
  /** Text used as the search index title. */
  searchTitle?: string
}
const p = Astro.props as Props
const store = await getStore()
const path = Astro.url.pathname
const strip = pickPlacement(store, 'strip', {path, section: p.section, sportId: p.sportId})
const fullTitle = path === '/' ? p.title : `${p.title} | RacketWiki`
const canonical = p.canonical ?? abs(path)
const crumbs = p.crumbs ?? []
const ld = [...siteJsonLd(), ...(crumbs.length > 1 ? [breadcrumbJsonLd(crumbs)] : []), ...(p.jsonLd ?? [])]
const sectionLabel = p.section ? SECTIONS[p.section].label : 'Pages'
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={p.description} />
    <link rel="canonical" href={canonical} />
    {p.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RacketWiki" />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,800;1,6..72,400&family=Inter:wght@400;500;600;700&family=Radio+Canada+Big:wght@500;700&display=swap" />
    {ld.map((d) => <JsonLd data={d} />)}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <SponsorStrip placement={strip} />
    <Header active={p.navActive ?? p.section} showSearch={p.headerSearch !== false} />
    <div id="content" data-pagefind-body={p.noindex ? undefined : ''}>
      <span data-pagefind-filter="section" hidden>{sectionLabel}</span>
      {p.searchTitle && <span data-pagefind-meta="title" hidden>{p.searchTitle}</span>}
      <slot />
    </div>
    <div class="wrap mistake" data-pagefind-ignore>
      <a class="hl" href={`/corrections/?page=${encodeURIComponent(path)}`}>Spotted a mistake? Tell us</a>
    </div>
    <Footer />
  </body>
</html>
<style>
  .mistake { margin-top: 24px; font-size: 14px; font-weight: 600; color: var(--sec-sources); }
</style>
